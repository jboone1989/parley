# Private development mode: localhost and random .bridge-secret file.
PARLEY_PLUGIN_PORT=8787

# Cloudflare Access Managed OAuth / MCP Access app (preferred)
# PARLEY_CF_ACCESS_TEAM=https://YOURTEAM.cloudflareaccess.com
# PARLEY_CF_ACCESS_AUD=YOUR_APP_AUD_TAG

# Alternative external OAuth provider; do not combine with Cloudflare mode.
# PARLEY_MCP_PUBLIC_URL=https://parley-mcp.livingruntime.com
# PARLEY_OAUTH_ISSUER=https://your-oauth-issuer.example.com
# PARLEY_OAUTH_AUDIENCE=https://parley-mcp.livingruntime.com
# PARLEY_OAUTH_JWKS_URL=https://your-oauth-issuer.example.com/.well-known/jwks.json
